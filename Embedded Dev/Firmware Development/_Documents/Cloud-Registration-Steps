# Generate an Eliptic Curve (EC) ES256 private / public 		key pair
openssl ecparam -genkey -name prime256v1 -noout -out ec_private.pem
openssl ec -in ec_private.pem -pubout -out ec_public.pem

Key generation is successful and is stored on the google cloud

# Create a new Cloud IoT device
gcloud iot devices create esp32 \
  --region=us-central1 \
  --registry=Reg_R6 \
  --public-key="path=./ec_public.pem,type=es256"

  To fetch private key to upload to firmware, run following command

  openssl ec -in ec_private.pem -noout -text


